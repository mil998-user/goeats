# Base de datos. Elige una de las dos (ver docs/BASE_DE_DATOS_EQUIPO.md).
# Base compartida del equipo (TiDB Cloud): pide tus datos a Deyvi por privado y guarda ca.pem en backend/certs/.
# sslaccept=strict verifica el certificado del servidor; sin eso el backend no arranca contra una base remota.
# DATABASE_URL="mysql://USUARIO:CONTRASENA@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/goeats?sslaccept=strict&sslcert=../certs/ca.pem"
# Base local de pruebas (npm run db:local):
DATABASE_URL="mysql://root:@127.0.0.1:3309/goeats"
PORT=5000
JWT_SECRET="your-secret-key-here"
NODE_ENV="development"

# SMTP Configuration
SMTP_HOST="smtp.example.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="user@example.com"
SMTP_PASS="your-password"
SMTP_FROM_NAME="GoEats"

# Google & Facebook OAuth (Opcional para validación estricta de Client ID / App ID en backend)
GOOGLE_CLIENT_ID="tu-client-id-de-google.apps.googleusercontent.com"
FACEBOOK_APP_ID="tu-app-id-de-facebook"
FACEBOOK_APP_SECRET="tu-app-secret-de-facebook"

# Permite vaciar pedidos y ventas desde el panel de administrador. Nunca activar con datos reales.
ALLOW_DATABASE_RESET="false"

# Acepta el simulador de Payphone sin cobrar. Solo para demos, nunca con usuarios reales.
ALLOW_SIMULATED_PAYMENTS="false"

# Clave para cifrar datos sensibles. Generar con: openssl rand -base64 32
# Obligatoria en producción. Si cambia, lo ya cifrado deja de poder leerse.
DATA_ENCRYPTION_KEY=""

# Solo al publicar detrás de un proxy: cantidad de proxys delante del servidor.
# Sin esto, el límite de intentos no ve la IP real de cada persona.
TRUST_PROXY=""

# Contraseñas de las cuentas demo que crea el seed (admin, motorizado y dueños).
# En una copia local se usan las de demo; en producción el seed se detiene si faltan.
SEED_ADMIN_PASSWORD=""
SEED_DRIVER_PASSWORD=""
SEED_OWNER_PASSWORD=""

# Direcciones del frontend publicado que pueden llamar al servidor, separadas por coma.
# Ejemplo: "https://goeats.vercel.app". En desarrollo no hace falta.
CORS_ORIGINS=""

# Segundos que se guarda en memoria la lista pública de restaurantes (0 la apaga).
PUBLIC_LIST_CACHE_SECONDS="30"
