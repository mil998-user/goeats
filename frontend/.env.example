# URL de la API del Backend (por defecto http://localhost:5000/api)
VITE_API_URL=http://localhost:5000/api

# Google Identity Services (Client ID obtenido de Google Cloud Console)
# Ejemplo: 123456789012-abc123def456.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

# Facebook Login (App ID obtenido de Meta for Developers)
# Ejemplo: 123456789012345
VITE_FACEBOOK_APP_ID=

# Cuenta bancaria de GoEats para recargas y Plus. Sin estos datos la web
# avisa que la cuenta no está configurada; nunca muestra números inventados.
VITE_PLATFORM_BANK_NAME=
VITE_PLATFORM_BANK_TYPE=
VITE_PLATFORM_BANK_ACCOUNT=
VITE_PLATFORM_BANK_OWNER=
VITE_PLATFORM_BANK_RUC=

# Solo al publicar: servidor de avisos en tiempo real. Si se deja vacío usa el mismo de VITE_API_URL.
VITE_SOCKET_URL=

# Pago con tarjeta. Dejar en false hasta tener proveedor de pagos.
VITE_CARD_PAYMENTS=false
